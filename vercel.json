{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/gmail",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/ical",
      "schedule": "0 3 * * *"
    }
  ]
}
