# Copy this file to .env and fill in the values. .env is gitignored — never
# commit real secrets. docker-compose reads this file; it sets REDIS_URL itself.

# ── Required to boot ────────────────────────────────────────────────────────

# Anthropic API key — the AI extraction/classification calls. Without it,
# extraction fails but the server still starts.
ANTHROPIC_API_KEY=

# Signs the session cookie (any long random string). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Redis. Left blank here on purpose — docker-compose injects
# redis://redis:6379. Only set this if you run the server WITHOUT compose
# (then use redis://localhost:6379).
REDIS_URL=

# ── Google OAuth (needed to actually sign in) ───────────────────────────────
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console. Add the
# redirect URI below to its "Authorized redirect URIs", or sign-in will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Optional (features degrade gracefully without them) ─────────────────────

# Google Places API key — address autocomplete/enrichment.
GOOGLE_PLACES_API_KEY=

# Resend API key — the evening summary email. Unset = no summary sent.
RESEND_API_KEY=

# Gmail push (Pub/Sub). Only needed to receive live webhook mail locally, which
# requires a public tunnel; leave unset for ordinary local dev.
PUBSUB_TOPIC=
PUBSUB_PUSH_SA=

# Shared secret guarding the /api/cron/* endpoints when you hit them by hand.
CRON_SECRET=
